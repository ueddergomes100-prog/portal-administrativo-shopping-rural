rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() {
      return signedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function canUpload() { return role() in ['owner', 'manager', 'marketing', 'site']; }

    match /products/{productId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if canUpload() && request.resource.size < 10 * 1024 * 1024;
    }
    match /arts/{artId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if canUpload() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
