# =============================================================================
# Portal Shopping Rural — variáveis de ambiente
# Copie para `.env` (máquina da loja) ou cadastre na Vercel (Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo de exemplo nem no Git.
# =============================================================================

# --- Onde os dados ficam -------------------------------------------------------
# local     = arquivo data/portal-db.json nesta máquina (login próprio do portal)
# firestore = Cloud Firestore + Firebase Authentication (obrigatório na Vercel)
DATA_BACKEND=local

# --- Servidor local -------------------------------------------------------------
# 127.0.0.1 = só esta máquina. 0.0.0.0 = outras máquinas da rede da loja também acessam.
HOST=127.0.0.1
PORT=4173
# Pastas (relativas à raiz do projeto)
DATA_DIR=data
MEDIA_DIR=media

# --- Fotos e arquivos de arte enviados pelo portal ---------------------------------
# auto = Vercel Blob se houver BLOB_READ_WRITE_TOKEN (criado pela Vercel em Storage → Blob); senão media/uploads/
STORAGE_DRIVER=auto
BLOB_READ_WRITE_TOKEN=

# Segredo que assina as sessões do modo local. Se ficar vazio, é gerado em data/.session-secret.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

# --- UniPlus (conector local) ---------------------------------------------------
# API local do UniPlus nesta máquina. Ex.: http://127.0.0.1:3001
UNIPLUS_API_URL=
# Intervalo de sincronização em segundos (30 = estoque quase em tempo real; só envia o que mudou)
UNIPLUS_SYNC_SECONDS=30
# Conferência completa (inclui produtos que sumiram do UniPlus) a cada N horas
UNIPLUS_FULL_SYNC_HOURS=6
# true = o próprio servidor local sincroniza. Na Vercel, use `npm run connector` na máquina da loja.
UNIPLUS_AUTO_SYNC=true

# Conector → portal na Vercel (usado por `npm run connector` quando o portal está na nuvem)
# PORTAL_URL=https://portal.shoppingrural.com.br
# Token compartilhado entre o conector e o servidor do portal (mesmo valor nos dois lados).
CONNECTOR_TOKEN=

# --- Firebase (somente com DATA_BACKEND=firestore) --------------------------------
FIREBASE_PROJECT_ID=portalspr-e0490
# Configuração PÚBLICA do app web (Console Firebase → Configurações do projeto → Seus apps).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=portalspr-e0490.firebaseapp.com
FIREBASE_WEB_APP_ID=
# Credencial PRIVADA da conta de serviço (Admin SDK). Use UMA das duas:
#  - Vercel: cole o JSON inteiro em uma linha
FIREBASE_SERVICE_ACCOUNT_JSON=
#  - Máquina local: caminho do arquivo .json (fora do Git!)
GOOGLE_APPLICATION_CREDENTIALS=
# E-mail que vira dono no primeiro login (só enquanto não existir nenhum dono).
BOOTSTRAP_OWNER_EMAIL=

# --- Site próprio (docs/SITE.md) -----------------------------------------------------
# Token que o SERVIDOR do site usa para enviar pedidos ao portal (POST /api/store/orders).
STORE_API_TOKEN=
# Endereço do site e caminho da página de produto ({slug} vira o identificador do produto).
STORE_PUBLIC_URL=
STORE_PRODUCT_PATH=/produto/{slug}
# Origens que podem ler o catálogo direto do navegador (CORS). Vazio = só servidor a servidor.
STORE_ALLOWED_ORIGINS=
# Endereço público deste portal (monta as URLs das fotos do catálogo).
PORTAL_PUBLIC_URL=

# --- Indicadores: atualização automática a cada N horas (0 = só manual) ------------
METRICS_SYNC_HOURS=6

# --- Google Analytics 4 -------------------------------------------------------------
GA4_PROPERTY_ID=
# JSON da conta de serviço (em uma linha) com acesso de Leitor na propriedade.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Ads ---------------------------------------------------------------------
GOOGLE_ADS_CUSTOMER_ID=
# Só se a conta for acessada por uma MCC (conta gerenciadora).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v20

# --- Meta Ads e Lead Ads --------------------------------------------------------------
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
# Formulários de Lead Ads (IDs separados por vírgula) e token da página com leads_retrieval.
META_LEAD_FORM_IDS=
META_PAGE_ACCESS_TOKEN=

# --- Entrada de leads por ferramentas externas (site, WhatsApp, Zapier/Make) ----------
# Segredo longo. Ferramentas enviam POST /api/leads/inbound com Authorization: Bearer <token>.
LEADS_WEBHOOK_TOKEN=
