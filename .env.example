# =============================================================================
# Portal Shopping Rural — variáveis de ambiente
# Copie para `.env` (máquina da loja) ou cadastre na Vercel (Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo de exemplo nem no Git.
# =============================================================================

# --- Onde os dados ficam -------------------------------------------------------
# local     = arquivo data/portal-db.json nesta máquina (login próprio do portal)
# firestore = Cloud Firestore + Firebase Authentication (obrigatório na Vercel)
DATA_BACKEND=local

# --- Servidor local -------------------------------------------------------------
# 127.0.0.1 = só esta máquina. 0.0.0.0 = outras máquinas da rede da loja também acessam.
HOST=127.0.0.1
PORT=4173
# Pastas (relativas à raiz do projeto)
DATA_DIR=data
MEDIA_DIR=media

# Segredo que assina as sessões do modo local. Se ficar vazio, é gerado em data/.session-secret.
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_HOURS=12

# --- UniPlus (conector local) ---------------------------------------------------
# API local do UniPlus nesta máquina. Ex.: http://127.0.0.1:3001
UNIPLUS_API_URL=
# Intervalo de sincronização em segundos
UNIPLUS_SYNC_SECONDS=300
# true = o próprio servidor local sincroniza. Na Vercel, use `npm run connector` na máquina da loja.
UNIPLUS_AUTO_SYNC=true

# Conector → portal na Vercel (usado por `npm run connector` quando o portal está na nuvem)
# PORTAL_URL=https://portal.shoppingrural.com.br
# Token compartilhado entre o conector e o servidor do portal (mesmo valor nos dois lados).
CONNECTOR_TOKEN=

# --- Firebase (somente com DATA_BACKEND=firestore) --------------------------------
FIREBASE_PROJECT_ID=portalspr-e0490
# Configuração PÚBLICA do app web (Console Firebase → Configurações do projeto → Seus apps).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=portalspr-e0490.firebaseapp.com
FIREBASE_WEB_APP_ID=
# Credencial PRIVADA da conta de serviço (Admin SDK). Use UMA das duas:
#  - Vercel: cole o JSON inteiro em uma linha
FIREBASE_SERVICE_ACCOUNT_JSON=
#  - Máquina local: caminho do arquivo .json (fora do Git!)
GOOGLE_APPLICATION_CREDENTIALS=
# E-mail que vira dono no primeiro login (só enquanto não existir nenhum dono).
BOOTSTRAP_OWNER_EMAIL=

# --- Nuvemshop --------------------------------------------------------------------
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
# A Nuvemshop exige User-Agent com nome do app e contato.
NUVEMSHOP_USER_AGENT=Portal Shopping Rural (contato@seudominio.com.br)
NUVEMSHOP_API_BASE=https://api.nuvemshop.com.br/v1

# --- Google Analytics 4 (leitura de relatórios: a implementar) --------------------
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google Ads (a implementar) ---------------------------------------------------
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=

# --- Meta Ads (a implementar) -----------------------------------------------------
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
